<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundle is signed with the hardened runtime, which shuts the
	     microphone unless the app declares it. This is the only device Talkie
	     touches. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
